{
  "name": "livetranslate",
  "productName": "LiveTranslate",
  "version": "0.1.0",
  "description": "Real-time, fully offline speech translation for phone calls on macOS.",
  "author": "LiveTranslate Contributors",
  "license": "MIT",
  "homepage": "https://github.com/livetranslate/livetranslate",
  "repository": {
    "type": "git",
    "url": "https://github.com/livetranslate/livetranslate.git"
  },
  "main": "dist-electron/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && electron-builder --dir",
    "build:renderer": "vite build",
    "build:ts": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run setup:models && npm run icons && npm run build && electron-builder",
    "dist:mac": "npm run setup:models && npm run icons && npm run build && electron-builder --mac",
    "setup:models": "bash scripts/setup-models.sh",
    "icons": "node scripts/generate-icons.mjs && iconutil -c icns build/icon.iconset -o build/icon.icns",
    "prepare": "husky",
    "electron:dev": "vite"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@electron/notarize": "^2.5.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.6",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "electron-log": "^5.2.3",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  }
}
